<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dept">

    <select id="queryAllDept" resultType="com.bi.queryer.sys.common.KeyValuePair">
        SELECT
          dept_id as `key`,
          dept_path_name as `value`
        FROM
          bi_portal.sys_dept
    </select>
</mapper>