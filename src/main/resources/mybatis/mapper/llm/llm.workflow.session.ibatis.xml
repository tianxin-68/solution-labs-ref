<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="llm.workflow.session">

    <select id="getWfAnalysisFilterById" parameterType="String" resultType="String">
        select
            wf_analysis_filter
        from
            wf_session
        where
            wf_session_id = #{wfSessionId}
    </select>

</mapper>