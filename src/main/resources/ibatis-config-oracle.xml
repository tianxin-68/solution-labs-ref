<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMapConfig PUBLIC "-//ibatis.apache.org//DTD SQL Map Config 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-config-2.dtd">

<sqlMapConfig>
	<settings enhancementEnabled="true" maxTransactions="20"
		maxRequests="32" maxSessions="10" useStatementNamespaces="true"
		useColumnLabel="true"/>

	<typeHandler jdbcType="CLOB" javaType="java.lang.String"
		callback="org.springframework.orm.ibatis.support.ClobStringTypeHandler" />
	<sqlMap resource="ibatis/oracle/base.ibatis.xml" />
	<sqlMap resource="ibatis/oracle/option.ibatis.xml" />
	<sqlMap resource="ibatis/oracle/user.ibatis.xml" />
	<sqlMap resource="ibatis/oracle/operateTable.ibatis.xml" />
	
</sqlMapConfig>

